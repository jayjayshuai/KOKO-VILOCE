root = true

[*.java]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
max_line_length = 120

[*.{xml,yml,yaml,json,js,mjs,ts,vue,css,md}]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
max_line_length = 120

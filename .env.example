# Copy to deploy/.env only on the target host. Never commit real credentials.
KOKO_DB_PASSWORD=replace-with-a-random-password
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-the-server-nacos-password
KOKO_GATEWAY_INTERNAL_KEY=replace-with-at-least-32-random-ascii-characters
ASSET_MINIO_ACCESS_KEY=replace-with-the-scoped-minio-access-key
ASSET_MINIO_SECRET_KEY=replace-with-the-scoped-minio-secret-key
LIVEKIT_API_KEY=replace-with-a-random-public-identifier
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_PUBLIC_URL=wss://rtc.example.com
# 媒体准入候选，两端开关默认关闭。先收为私有SFU信令并完成全链路/TLS验收。
# 启用时媒体URL改为 wss://app.example.com/koko-api/media/livekit ，不是原始SFU管理地址。
MEDIA_ADMISSION_ENABLED=false
VOICE_SIGNAL_ADMISSION_ENABLED=false
VOICE_MEDIA_PLAN_ENABLED=false
VOICE_MEDIA_RETIREMENT_ENABLED=false
VOICE_BINDING_ADMISSION_ENABLED=false
VOICE_MEDIA_CREDENTIALS_ENABLED=false
VOICE_SESSION_REAPER_ENABLED=false
MEDIA_ALLOWED_ORIGINS=https://app.example.com
# 明确允许的Web来源，逗号分隔；不在公开模板中保存真实服务器地址。
KOKO_CHAT_ALLOWED_ORIGINS=https://app.example.com
# TLS profile仅使用受保护证书发布目录，不把ACME账号/私钥写在源码或提交配置中。
KOKO_TLS_CONFIG_FILE=replace-with-absolute-tls-nginx-config-path
KOKO_TLS_SERVING_DIR=replace-with-protected-serving-certificate-directory
# Media budgets include READY images and incomplete uploads awaiting cleanup.
ASSET_OWNER_QUOTA_BYTES=104857600
ASSET_OWNER_QUOTA_IMAGES=100
ASSET_TOTAL_QUOTA_BYTES=1073741824
ASSET_TOTAL_QUOTA_IMAGES=10000

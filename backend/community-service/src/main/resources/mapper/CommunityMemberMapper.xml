<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.kokonexus.community.infrastructure.persistence.CommunityMemberMapper">
    <select
    id="current"
    resultType="cn.kokonexus.community.domain.CommunityMember"
    timeout="2"
    useCache="false"
    flushCache="true"
  >
        SELECT * FROM community_member WHERE community_id = #{id} AND user_id = #{userId} FOR UPDATE
    </select>
    <select
    id="page"
    resultType="cn.kokonexus.community.domain.CommunityMember"
    timeout="2"
    useCache="false"
    flushCache="true"
  >
        SELECT * FROM community_member WHERE community_id = #{id}
        <if test="before != null">AND user_id &lt; #{before}</if>
        ORDER BY user_id DESC LIMIT #{size} FOR UPDATE
    </select>
</mapper>
